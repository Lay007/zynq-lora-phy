__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
build/
dist/

# PlatformIO generated products
**/.pio/

# Generated measurements and vendor build products
artifacts/
experiments/runs/
experiments/configs/*.local.json
captures/*.bin
captures/*.npy
captures/*.npz
captures/**/*.cf32
captures/**/*.cu8
captures/**/*.cfile
!captures/reference/**/*.cf32
!captures/reference/**/*.cu8
!captures/reference/**/*.cfile
fpga/build/
fpga/.Xil/
# Vivado also drops a scratch directory beside the working directory it was
# launched from, which for the board scripts is the repository root.
/.Xil/
# Vivado PS7 summary emitted at the repository root when the board preset has
# no report output directory configured.
/NA/

# Vivado journal, log, and strategy files. Deliberately scoped instead of a
# repository-wide *.log so that a published run log stays committable.
vivado*.jou
vivado*.log
vivado*.str
fpga/**/*.jou
fpga/**/*.log
fpga/**/*.str

# MATLAB and Simulink generated products
**/slprj/
**/*.slxc
**/codegen/
**/work/
*.asv

# Editors, scratch, OS and IDE-local files
# The article draft is kept local only. It is a work in progress that tracks
# an open investigation, so it is not published from this repository.
article/
.idea/
.vscode/
tmp/
.DS_Store
Thumbs.db
desktop.ini
*.vcxproj.user
*.pcm
.vs/

# Local state of development tools and assistants (sessions, worktrees,
# per-user settings); never part of the project.
.claude/
CLAUDE.md
CLAUDE.local.md
.codex/
.kilo/
.kilocode/
.cursor/
.aider*
.continue/

# Script-generated Simulink models and reports
model/simulink/generated/

# HDL Coder traceability reports are large regenerable HTML; the Verilog and
# the resource report summary are what matter for review.
fpga/generated/**/html/
fpga/generated/**/_htmllib/
fpga/generated/**/*.slx
fpga/generated/**/*.mat
experiments/per/
experiments/noise/
